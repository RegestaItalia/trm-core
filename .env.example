# E2E harness connector: REST (default), RFC or OpenRFC.
SAP_CONNECTOR=REST
# REST only.
SAP_URL=ABC
# RFC / OpenRFC: required application server host and system number.
SAP_ASHOST=
SAP_SYSNR=00
# Optional RFC / OpenRFC SAProuter string and trace directory.
SAP_SAPROUTER=
SAP_RFC_TRACE_DIR=
# RFC only: parent directory containing node-rfc; blank uses global npm modules.
SAP_RFC_MODULES_PATH=
# Shared logon settings.
SAP_USER=ABC
SAP_PASSWORD=ABC
SAP_CLIENT=000
SAP_LANGUAGE=EN
SAP_ALLOW_WRITES=false
SAP_ALLOW_DATA_PREVIEW=false
SAP_ALLOW_FREE_SQL=false
SAP_ALLOW_TRANSPORT_WRITES=false
SAP_ALLOW_GIT_WRITES=false
SAP_ALLOWED_PACKAGES='$*,Z*,Y*,/ATRM/*'
SAP_ALLOWED_TRANSPORTS=
SAP_DENY_ACTIONS=
SAP_BLOCKED_DATA_SOURCES=
SAP_CHECK_BEFORE_WRITE=true
ARC1_MAX_CONCURRENT=1
TRM_PUBLIC_REGISTRY_ENDPOINT=
TRM_PUBLIC_REGISTRY_TOKEN=
